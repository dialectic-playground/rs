{
  // Dev container for VS Code, JetBrains, and Codespaces. It uses the same image as
  // `make` and CI (../Containerfile). For Podman, set "dev.containers.dockerPath": "podman".
  "name": "dialectic-playground/rs",
  "build": {
    "dockerfile": "../Containerfile",
    "context": "."
  },
  "containerEnv": {
    "DP_IN_CONTAINER": "1"
  },
  "updateRemoteUserUID": true
}
